# ──────────────────────────────────────────────────────────────
# AIOS Platform — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets. All `.env*` files are gitignored except this one.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required) ──
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (a.k.a. "anon") key. Newer Supabase dashboards call it the
# "publishable" key; older ones call it "anon". The app accepts EITHER name —
# set whichever your dashboard shows. Use only ONE.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy/alternate name (optional — used as a fallback if the one above is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Optional for this build (used by admin/maintenance tooling).
# REQUIRED for Stripe billing: the webhook + checkout provisioning write subscription
# state with this key (bypassing RLS). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
# Public site URL — used to build auth email redirect links (password reset, email confirm)
# AND Stripe Checkout/Portal success & cancel return URLs. Set to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Harmony AI provider (optional) ──
# Harmony ships with a built-in, no-cost mock assistant, so the app runs with NO
# API key and makes NO external calls. Leave AI_PROVIDER=mock to use it.
#
# To enable real AI responses, set AI_PROVIDER to "openai", "anthropic", or
# "azure" and
# supply the matching key below. If the selected provider has no key, Harmony
# safely falls back to the mock assistant for the existing OpenAI/Anthropic
# modes. Azure configuration fails closed instead of switching providers.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai
OPENAI_API_KEY=
# Required only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required only when AI_PROVIDER=azure. Use the Azure OpenAI resource endpoint;
# never include credentials or query parameters in the endpoint value.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Optional single model override for whichever provider is active. Leave blank to
# use the per-provider default:
#   AI_PROVIDER=openai     → "gpt-4o-mini"
#   AI_PROVIDER=anthropic  → "claude-3-5-haiku-latest"
#   AI_PROVIDER=azure      → required Azure deployment name (no fallback)
AI_MODEL=

# ── Stripe billing (optional — leave blank to disable billing) ──
# The app builds and runs WITHOUT these set; billing endpoints return 503 and the
# pricing page renders, but checkout/portal/webhooks are inert until configured.
#
# Secret key: Stripe Dashboard → Developers → API keys (use a test key in dev).
STRIPE_SECRET_KEY=
# Webhook signing secret: Stripe Dashboard → Developers → Webhooks → your endpoint
# (endpoint URL: {NEXT_PUBLIC_SITE_URL}/api/stripe/webhook). Or `stripe listen` in dev.
STRIPE_WEBHOOK_SECRET=
# Price IDs (one recurring price per plan). Create Products + Prices in Stripe,
# then paste each Price ID (price_...). Enterprise is optional (contact-sales when unset).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# ── Subscription enforcement (PR #6) — OFF by default ──
# Master switch for Harmony hub plan-gating. Leave unset/"off" to keep all hubs
# open (nothing is paywalled). Set to "on" ONLY after validating Stripe in test
# mode. When off, the hub layout does no billing work at all.
BILLING_ENFORCEMENT=off
# Optional: ISO date. Users created before this are exempt from gating
# (grandfathered) so no existing user is ever locked out. Example: 2026-06-06.
BILLING_ENFORCEMENT_CUTOFF=

# ── Integrations framework (PR #7) — all optional ──
# Each provider stays "Coming soon" until its credentials are set. The app
# builds and runs with none of these. Redirect URI for OAuth providers is
# {NEXT_PUBLIC_SITE_URL}/api/integrations/<provider>/callback.
#
# OpenAI uses the existing OPENAI_API_KEY (see the AI provider section above).
#
# Google (Calendar, Gmail, YouTube) — one OAuth client, scopes per product.
# Authorized redirect URIs: .../api/integrations/google_calendar/callback,
# .../api/integrations/gmail/callback, .../api/integrations/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn — SIGN-IN only (the "Harmony" app: Sign In with LinkedIn / OpenID
# Connect; scopes openid profile email). Identity + connector status only.
# Redirect URI: .../api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn — organization PUBLISHING (the "AIOS Publisher" app: Community
# Management API + w_organization_social, associated with the company Page).
# Publishing uses THESE, never the sign-in connector above. The access token is
# an AIOS Publisher app token authorized by a Page admin with w_organization_social.
LINKEDIN_PUBLISHER_ACCESS_TOKEN=
# The organization (company Page) to post as — either form is accepted:
#   urn:li:organization:1234567   or   1234567
# This approved organization is authoritative. A connected LinkedIn channel
# handle may display the same organization, but publishing is blocked if it
# resolves to a different organization.
LINKEDIN_ORGANIZATION_URN=
# Optional legacy/fallback numeric form if LINKEDIN_ORGANIZATION_URN is unset.
LINKEDIN_ORGANIZATION_ID=
# Optional: pin the LinkedIn API version (defaults to 202604).
LINKEDIN_API_VERSION=
# X — OAuth 2.0 user-context publishing for text, single-image, and multi-image
# test drafts. Required scopes in the X Developer Portal/app authorization are:
# tweet.read tweet.write users.read media.write offline.access
# Redirect URI: .../api/integrations/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# TikTok — redirect URI: .../api/integrations/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Vercel — optional direct, read-only deployment evidence for Mason/Harmony.
# Create a Vercel token with the minimum project/team read scope practical for
# the AIOS project. Never expose this value to the browser or commit it.
VERCEL_TOKEN=
# Team/project identifiers that restrict every direct read to AIOS.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Public canonical production target used only for alias verification.
VERCEL_PROJECT_PRODUCTION_URL=https://aios-platform-omega.vercel.app

# ── Token-at-rest encryption (Option A) ──
# AES-256-GCM key for encrypting connector OAuth/API tokens at rest. Generate
# with:  openssl rand -base64 32   (a 32-byte base64 string; 64-char hex or any
# 16+ char secret also accepted). OPTIONAL — until set, tokens are stored as
# before (dual-read, no breakage); once set, new writes are encrypted server-side
# and decrypted only on the server. After setting it, POST once to
# /api/admin/encrypt-tokens to backfill any existing plaintext tokens.
TOKEN_ENCRYPTION_KEY=

# ── AIOS Event Mesh (portable workforce transport) ──
# PostgreSQL remains the durable source of truth. Use "postgres" as the
# baseline/fallback transport, "nats" for JetStream-backed real-time delivery,
# or "local" only for tests/lightweight local development.
AIOS_EVENT_MESH_PROVIDER=postgres
AIOS_EVENT_MESH_OUTBOX_ENABLED=true
# Keep asynchronous workforce execution in shadow mode until production workers,
# migrations, and approval boundaries are verified. When false/unset, the mesh
# records and delivers events without taking over existing synchronous behavior.
AIOS_EVENT_MESH_WORKFORCE_EXECUTION=false
AIOS_EVENT_MESH_WORKER_ID=
AIOS_EVENT_MESH_POLL_INTERVAL_MS=1000
AIOS_EVENT_MESH_LEASE_SECONDS=60
AIOS_EVENT_MESH_BATCH_SIZE=10
AIOS_EVENT_MESH_WORKFORCE_CONSUMER=aios-workforce-dispatcher
AIOS_EVENT_MESH_WORKFORCE_CONCURRENCY=2
# NATS JetStream. Required only when AIOS_EVENT_MESH_PROVIDER=nats.
AIOS_EVENT_MESH_NATS_URL=nats://127.0.0.1:4222
AIOS_EVENT_MESH_NATS_STREAM=AIOS_EVENTS
AIOS_EVENT_MESH_NATS_SUBJECT_PREFIX=aios.events
AIOS_EVENT_MESH_NATS_TLS=false
AIOS_EVENT_MESH_NATS_TOKEN=
AIOS_EVENT_MESH_NATS_USER=
AIOS_EVENT_MESH_NATS_PASSWORD=
