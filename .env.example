# ──────────────────────────────────────────────────────────────
# AIOS Platform — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets. All `.env*` files are gitignored except this one.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required) ──
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (a.k.a. "anon") key. Newer Supabase dashboards call it the
# "publishable" key; older ones call it "anon". The app accepts EITHER name —
# set whichever your dashboard shows. Use only ONE.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy/alternate name (optional — used as a fallback if the one above is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Optional for this build (used by admin/maintenance tooling).
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
# Public site URL — used to build auth email redirect links (password reset, email confirm).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Life Operator AI provider (optional) ──
# Leave AI_PROVIDER as "mock" to use the built-in, no-cost mock assistant (no external calls).
# Set to "openai" or "anthropic" and supply the matching key to enable real responses.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override (e.g. gpt-4o-mini or claude-3-5-haiku-latest). Falls back to a sane default.
AI_MODEL=
